{
  "expo": {
    "name": "Waltzy",
    "slug": "waltzy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF8F0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.antoniobeslic.waltzy",
      "backgroundColor": "#FFF8F0",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "de"
        ],
        "CFBundleDevelopmentRegion": "en"
      },
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:waltzy.antoniobeslic.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2A2140",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.antoniobeslic.waltzy",
      "userInterfaceStyle": "light",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "waltzy.antoniobeslic.com",
              "pathPrefix": "/c/"
            },
            {
              "scheme": "https",
              "host": "waltzy.antoniobeslic.com",
              "pathPrefix": "/s/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FFF8F0"
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Waltzy uses the camera to scan the QR code of a class or a shared dance.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": "waltzy",
    "owner": "thisistoni",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ace320bd-b7cc-46b0-83d9-c11528353447"
      }
    },
    "locales": {
      "de": "./locales/de.json"
    }
  }
}
